<section class="relative min-h-screen flex items-center px-4 py-2 md:py-4 bg-transparent">
  <div class=" mb-24 w-full max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
    <!-- Text Content -->
    <div class="col-span-1 md:col-span-7 order-2 md:order-1 animate-slideInLeft">
      <h1 class="text-6xl xs:text-6xl sm:text-7xl md:text-8xl font-bold mb-6 tracking-tight animate-fadeIn">
        <span class="relative inline-block">
          Hello
          <span class="absolute -bottom-2 xs:-bottom-3 left-0 w-full h-3 sm:h-4 bg-yellow-300 z-0"></span>
        </span>
      </h1>
      
      <div class="space-y-4">
        <p class="text-3xl xs:text-4xl sm:text-4xl md:text-5xl">
          I'm
          <span class="relative inline-block font-bold">
            Risang Sasotyaningtyas
            <span class="absolute -bottom-2 xs:-bottom-3 left-0 w-full h-3 sm:h-4 bg-pink-400 z-0 opacity-30"></span>
          </span>
        </p>
        
        <p class="text-3xl xs:text-3xl sm:text-4xl md:text-5xl">
          A
          <span class="relative inline-block font-bold animate-float">
            painter
            <span class="absolute -bottom-2 xs:-bottom-3 left-0 w-full h-3 sm:h-4 bg-blue-400 z-0 opacity-30"></span>
          </span>
        </p>
      </div>
    </div>

    <!-- Image Content -->
    <div class="col-span-1 md:col-span-5 order-1 md:order-2 flex justify-center animate-slideInRight">
      <div class="relative w-full max-w-[300px] xs:max-w-[340px] sm:max-w-[400px]">
        <div class="relative w-full aspect-square rounded-full bg-green-400 animate-pulse">
          <div class="absolute inset-1 rounded-full border-4 border-white z-10">
            <img 
              src="/Assets/main.webp" 
              alt="Risang Sasotyaningtyas" 
              class="w-full h-full object-cover rounded-full"
            />
          </div>
        </div>
        <div class="absolute w-1/3 aspect-square -bottom-4 -left-4 bg-yellow-300 rounded-full z-0 animate-float-delayed"></div>
      </div>
    </div>
  </div>
</section>