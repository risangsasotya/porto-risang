---
import "../styles/animations.css";
import Footer from "../shared/footer.astro";
---

<section id="works" class="bg-transparent min-h-screen px-4 sm:px-8 md:px-20 py-12">
  <div class="flex flex-col gap-6 max-w-4xl">
    <h2 class="text-4xl sm:text-5xl font-bold tracking-tight animate-fadeIn">
      <span class="relative inline-block">
        Selected Works
        <span class="absolute -bottom-4 left-0 w-full h-3 bg-blue-300 z-0"></span>
      </span>
    </h2>

    <p class="text-lg md:text-2xl leading-relaxed animate-slideInLeft">
      Explore my portfolio across different mediums. Choose a category to see a curated
      collection of pieces from each body of work.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <a
      href="/color-on-paper"
      class="group relative flex h-full flex-col justify-between rounded-3xl border-4 border-yellow-300 bg-white p-6 text-center font-bold transition-transform duration-300 hover:-translate-y-2 hover:scale-105"
    >
      <span class="text-2xl">Color on Paper</span>
      <span class="mt-4 inline-flex items-center justify-center gap-2 text-base font-semibold text-blue-500 transition-transform group-hover:translate-x-1">
        View Series
        <i class="fas fa-arrow-right"></i>
      </span>
      <span class="absolute -bottom-4 -right-4 h-14 w-14 rounded-full bg-blue-200 opacity-70 blur-sm"></span>
      <span class="absolute -top-6 -left-6 h-16 w-16 rounded-full bg-yellow-200 opacity-70 blur-sm"></span>
    </a>

    <a
      href="/lukis"
      class="group relative flex h-full flex-col justify-between rounded-3xl border-4 border-pink-300 bg-white p-6 text-center font-bold transition-transform duration-300 hover:-translate-y-2 hover:scale-105"
    >
      <span class="text-2xl">Lukis (Art on Canvas)</span>
      <span class="mt-4 inline-flex items-center justify-center gap-2 text-base font-semibold text-blue-500 transition-transform group-hover:translate-x-1">
        View Series
        <i class="fas fa-arrow-right"></i>
      </span>
      <span class="absolute -bottom-4 -right-4 h-14 w-14 rounded-full bg-pink-200 opacity-70 blur-sm"></span>
      <span class="absolute -top-6 -left-6 h-16 w-16 rounded-full bg-green-200 opacity-70 blur-sm"></span>
    </a>

    <a
      href="/pencil-on-paper"
      class="group relative flex h-full flex-col justify-between rounded-3xl border-4 border-green-300 bg-white p-6 text-center font-bold transition-transform duration-300 hover:-translate-y-2 hover:scale-105"
    >
      <span class="text-2xl">Pencil on Paper (BnW)</span>
      <span class="mt-4 inline-flex items-center justify-center gap-2 text-base font-semibold text-blue-500 transition-transform group-hover:translate-x-1">
        View Series
        <i class="fas fa-arrow-right"></i>
      </span>
      <span class="absolute -bottom-4 -right-4 h-14 w-14 rounded-full bg-green-200 opacity-70 blur-sm"></span>
      <span class="absolute -top-6 -left-6 h-16 w-16 rounded-full bg-yellow-200 opacity-70 blur-sm"></span>
    </a>

    <a
      href="/sketch"
      class="group relative flex h-full flex-col justify-between rounded-3xl border-4 border-blue-300 bg-white p-6 text-center font-bold transition-transform duration-300 hover:-translate-y-2 hover:scale-105"
    >
      <span class="text-2xl">Sketch</span>
      <span class="mt-4 inline-flex items-center justify-center gap-2 text-base font-semibold text-blue-500 transition-transform group-hover:translate-x-1">
        View Series
        <i class="fas fa-arrow-right"></i>
      </span>
      <span class="absolute -bottom-4 -right-4 h-14 w-14 rounded-full bg-blue-200 opacity-70 blur-sm"></span>
      <span class="absolute -top-6 -left-6 h-16 w-16 rounded-full bg-pink-200 opacity-70 blur-sm"></span>
    </a>
  </div>
</section>
<Footer />

