---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Color on Paper" description="Color on paper portfolio">
  <section class="min-h-screen px-4 sm:px-8 md:px-20 py-12 bg-transparent">
    <div class="max-w-4xl">
      <h1 class="text-4xl sm:text-5xl font-bold mb-6 tracking-tight">
        Color on Paper
      </h1>
      <p class="text-lg md:text-2xl leading-relaxed">
        This section will feature selected color-on-paper works. Content coming soon.
      </p>
    </div>

    <div class="mt-10">
      <a
        href="/#works"
        class="inline-flex items-center gap-2 rounded-full bg-blue-400 px-6 py-3 font-semibold text-white transition-transform duration-300 hover:scale-105"
      >
        <i class="fas fa-arrow-left"></i>
        Back to Works
      </a>
    </div>
  </section>
</Layout>


